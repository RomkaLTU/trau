# Local config (copy from trau.ini.example; .trau.ini for project/user scope)
trau.ini
.trau.ini
.trau.ini.bak*
trau.ini.bak*

# Agentic / internal files — kept out of the public repo (present locally).
# AGENTS.md, CLAUDE.md and CONTEXT.md are deliberately NOT here: agent guidance
# and the domain vocabulary are shared, so they must survive a fresh clone.
tasks/
runs/
/.agents/
/.claude/
/.serena/

# Per-developer dev-flow config (bind it to your own tracker/team locally)
/.dev-flow/

# Go build artifacts
/trau
/trau.exe
/bin/
/dist/
*.test
*.out
coverage.txt

# SPA toolchain (web/ is the Vite source; internal/webserver/dist is the
# embedded build output and IS tracked so `go build`/`go test` always compile)
/web/node_modules/
/web/.vite/
# npm is canonical here (web/package-lock.json is tracked); ignore stray pnpm locks
/web/pnpm-lock.yaml

# macOS Finder artifacts (were tracked once; never again)
.DS_Store

# IDE
/.idea/
# trau run artifacts and project config (do not commit), except the repo-owned
# verify checks. The `!.trau/` is load-bearing: a developer's global gitignore
# commonly excludes .trau/ wholesale, and git will not descend into an excluded
# directory to see the re-include below it.
!.trau/
.trau/*
!.trau/checks/
